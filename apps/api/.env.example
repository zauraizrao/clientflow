NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://prisma.PROJECT_REF:YOUR_PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres

CORS_ORIGIN=http://localhost:3000

# Shared only between the Next.js server and Express.
# Use different random values for these two secrets.
AUTH_BRIDGE_SECRET=replace-with-at-least-32-random-characters
API_AUTH_SECRET=replace-with-at-least-32-random-characters

INTERNAL_TOKEN_ISSUER=clientflow-web
INTERNAL_TOKEN_AUDIENCE=clientflow-api

# Supabase Storage - backend only
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=clientflow-files

# Resend transactional email
# disabled = no email delivery rows are created
# sandbox = all emails are rerouted to your Resend account email
# live = real recipients; requires a verified custom domain
EMAIL_DELIVERY_MODE=disabled
RESEND_API_KEY=
RESEND_FROM=ClientFlow <onboarding@resend.dev>
RESEND_SANDBOX_RECIPIENT=
APP_BASE_URL=http://localhost:3000

# Stripe Checkout - backend only.
# Keep disabled until using Stripe test mode.
STRIPE_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis / BullMQ background jobs - backend only.
# Local example: redis://localhost:6379
# Upstash TLS example: rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT:6379
REDIS_URL=
