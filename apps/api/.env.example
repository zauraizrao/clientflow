NODE_ENV=development
PORT=4000

# Supabase Session Pooler (port 5432) recommended for the long-running Express API.
# Replace PROJECT_REF, password, host/region with your own Supabase values.
DATABASE_URL=postgresql://prisma.PROJECT_REF:YOUR_PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres

CORS_ORIGIN=http://localhost:3000
