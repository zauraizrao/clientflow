NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://prisma.PROJECT_REF:YOUR_PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres

CORS_ORIGIN=http://localhost:3000

# Shared only between the Next.js server and Express.
# Use different random values for these two secrets.
AUTH_BRIDGE_SECRET=replace-with-at-least-32-random-characters
API_AUTH_SECRET=replace-with-at-least-32-random-characters

INTERNAL_TOKEN_ISSUER=clientflow-web
INTERNAL_TOKEN_AUDIENCE=clientflow-api
