generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  ADMIN
  MANAGER
  MEMBER
  CLIENT
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum WorkflowCategory {
  NOT_STARTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProjectMemberRole {
  LEAD
  MEMBER
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CollaborationVisibility {
  INTERNAL
  CLIENT
}

enum FileAssetStatus {
  PENDING
  READY
  FAILED
  DELETED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        OrganizationMember[]
  clients        Client[]
  clientContacts ClientContact[]
  projects       Project[]
  projectMembers ProjectMember[]
  projectColumns ProjectColumn[]
  tasks          Task[]
  taskAssignees  TaskAssignee[]

  files          FileAsset[]
  comments       Comment[]
  activityEvents ActivityEvent[]

  notifications Notification[]

  notificationPreferences NotificationPreference[]

  notificationDeliveries NotificationDelivery[]

  @@index([name])
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String?
  avatarUrl       String?
  passwordHash    String?
  googleSubject   String?   @unique
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships OrganizationMember[]

  @@index([email])
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  clientId       String?          @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectMemberships ProjectMember[]
  taskAssignments    TaskAssignee[]
  createdTasks       Task[]          @relation("TaskCreator")

  notificationsReceived Notification[] @relation("NotificationRecipient")

  notificationsActed Notification[] @relation("NotificationActor")

  notificationPreferences NotificationPreference[]
  uploadedFiles           FileAsset[]              @relation("FileUploader")
  comments                Comment[]                @relation("CommentAuthor")
  activityEvents          ActivityEvent[]          @relation("ActivityActor")

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([userId])
  @@index([clientId])
}

model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  email          String?
  phone          String?
  website        String?
  industry       String?
  description    String?
  status         ClientStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projects Project[]
  members  OrganizationMember[]
  contacts ClientContact[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, name])
}

model ClientContact {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  clientId       String @db.Uuid

  firstName String
  lastName  String?
  email     String?
  phone     String?
  jobTitle  String?
  isPrimary Boolean @default(false)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId])
  @@index([organizationId, clientId])
  @@index([organizationId, email])
  @@index([clientId, isPrimary])
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  clientId       String?       @db.Uuid
  name           String
  description    String?
  status         ProjectStatus @default(PLANNING)
  startDate      DateTime?
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  members ProjectMember[]
  columns ProjectColumn[]
  tasks   Task[]

  notifications  Notification[]
  files          FileAsset[]
  comments       Comment[]
  activityEvents ActivityEvent[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([clientId])
  @@index([dueDate])
}

model ProjectMember {
  id                   String            @id @default(uuid()) @db.Uuid
  organizationId       String            @db.Uuid
  projectId            String            @db.Uuid
  organizationMemberId String            @db.Uuid
  role                 ProjectMemberRole @default(MEMBER)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@unique([projectId, organizationMemberId])
  @@index([organizationId, projectId])
  @@index([organizationId, organizationMemberId])
  @@index([projectId, role])
}

model ProjectColumn {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  projectId      String           @db.Uuid
  name           String
  category       WorkflowCategory @default(NOT_STARTED)
  position       Int              @default(0)
  isArchived     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@unique([projectId, name])
  @@index([organizationId, projectId])
  @@index([projectId, position])
  @@index([organizationId, category])
  @@index([projectId, isArchived])
}

model Task {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  projectId       String       @db.Uuid
  projectColumnId String       @db.Uuid
  parentTaskId    String?      @db.Uuid
  createdById     String?      @db.Uuid
  title           String
  description     String?
  priority        TaskPriority @default(NORMAL)
  startDate       DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  position        Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectColumn ProjectColumn       @relation(fields: [projectColumnId], references: [id], onDelete: Restrict)
  parentTask    Task?               @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks      Task[]              @relation("TaskSubtasks")
  createdBy     OrganizationMember? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignees     TaskAssignee[]

  notifications  Notification[]
  files          FileAsset[]
  comments       Comment[]
  activityEvents ActivityEvent[]

  @@index([organizationId])
  @@index([projectId])
  @@index([projectColumnId])
  @@index([parentTaskId])
  @@index([createdById])
  @@index([organizationId, priority])
  @@index([projectId, projectColumnId, position])
  @@index([dueDate])
  @@index([completedAt])
}

model TaskAssignee {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @db.Uuid
  taskId               String   @db.Uuid
  organizationMemberId String   @db.Uuid
  createdAt            DateTime @default(now())

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task               Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@unique([taskId, organizationMemberId])
  @@index([organizationId, taskId])
  @@index([organizationId, organizationMemberId])
}

model FileAsset {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  projectId      String                  @db.Uuid
  taskId         String?                 @db.Uuid
  commentId      String?                 @db.Uuid
  uploadedById   String?                 @db.Uuid
  originalName   String
  storageBucket  String                  @default("clientflow-files")
  storagePath    String                  @unique
  mimeType       String
  extension      String?
  sizeBytes      Int
  visibility     CollaborationVisibility @default(INTERNAL)
  status         FileAssetStatus         @default(PENDING)
  failureReason  String?
  completedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  comment        Comment?            @relation(fields: [commentId], references: [id], onDelete: SetNull)
  uploadedBy     OrganizationMember? @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  activityEvents ActivityEvent[]

  notifications Notification[]

  @@index([organizationId, projectId, createdAt])
  @@index([projectId, taskId])
  @@index([commentId])
  @@index([uploadedById])
  @@index([organizationId, visibility, status])
  @@index([deletedAt])
}

model Comment {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @db.Uuid
  projectId       String                  @db.Uuid
  taskId          String?                 @db.Uuid
  authorId        String?                 @db.Uuid
  parentCommentId String?                 @db.Uuid
  body            String                  @db.Text
  visibility      CollaborationVisibility @default(INTERNAL)
  authorName      String?
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  author         OrganizationMember? @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parentComment  Comment?            @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies        Comment[]           @relation("CommentReplies")
  files          FileAsset[]
  activityEvents ActivityEvent[]

  notifications Notification[]

  @@index([organizationId, projectId, createdAt])
  @@index([projectId, taskId, createdAt])
  @@index([parentCommentId])
  @@index([authorId])
  @@index([organizationId, visibility])
  @@index([deletedAt])
}

model ActivityEvent {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  projectId      String                  @db.Uuid
  taskId         String?                 @db.Uuid
  commentId      String?                 @db.Uuid
  fileId         String?                 @db.Uuid
  actorId        String?                 @db.Uuid
  type           String
  visibility     CollaborationVisibility @default(INTERNAL)
  actorName      String?
  metadata       Json?
  createdAt      DateTime                @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  comment      Comment?            @relation(fields: [commentId], references: [id], onDelete: SetNull)
  file         FileAsset?          @relation(fields: [fileId], references: [id], onDelete: SetNull)
  actor        OrganizationMember? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId, createdAt])
  @@index([projectId, taskId, createdAt])
  @@index([commentId])
  @@index([fileId])
  @@index([actorId])
  @@index([organizationId, visibility, createdAt])
  @@index([type, createdAt])
}

enum NotificationCategory {
  TASKS
  COMMENTS
  FILES
  PROJECTS
  BILLING
  SYSTEM
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  recipientId    String               @db.Uuid
  actorId        String?              @db.Uuid
  category       NotificationCategory
  type           String
  title          String
  body           String?              @db.Text
  link           String?
  projectId      String?              @db.Uuid
  taskId         String?              @db.Uuid
  commentId      String?              @db.Uuid
  fileId         String?              @db.Uuid
  dedupeKey      String?
  readAt         DateTime?
  metadata       Json?
  createdAt      DateTime             @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient    OrganizationMember     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor        OrganizationMember?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  project      Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task         Task?                  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  comment      Comment?               @relation(fields: [commentId], references: [id], onDelete: SetNull)
  file         FileAsset?             @relation(fields: [fileId], references: [id], onDelete: SetNull)
  deliveries   NotificationDelivery[]

  @@unique([organizationId, recipientId, dedupeKey])
  @@index([organizationId, recipientId, readAt, createdAt])
  @@index([recipientId, readAt, createdAt])
  @@index([organizationId, category, createdAt])
  @@index([projectId])
  @@index([taskId])
  @@index([commentId])
  @@index([fileId])
}

model NotificationPreference {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  memberId       String               @db.Uuid
  category       NotificationCategory
  inAppEnabled   Boolean              @default(true)
  emailEnabled   Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, category])
  @@index([organizationId, memberId])
}

model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  organizationId    String                     @db.Uuid
  notificationId    String                     @db.Uuid
  channel           String                     @default("EMAIL")
  status            NotificationDeliveryStatus @default(PENDING)
  attemptCount      Int                        @default(0)
  scheduledAt       DateTime                   @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  provider          String?
  providerMessageId String?
  lastError         String?                    @db.Text
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([organizationId, status, scheduledAt])
  @@index([status, scheduledAt])
}
