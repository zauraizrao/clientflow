# Browser-safe URL. Client code should use the same-origin BFF route.
NEXT_PUBLIC_API_URL=/api/backend

# Auth.js cookie encryption secret. Web app only.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Server-only URL to the Express API.
API_SERVER_URL=http://localhost:4000

# These two values MUST match apps/api/.env.
AUTH_BRIDGE_SECRET=replace-with-at-least-32-random-characters
API_AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional while setting up credentials login.
# Required before Google OAuth is considered complete.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
